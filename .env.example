# Required: PostgreSQL connection string
DATABASE_URL=postgresql://nawa:nawa_local@localhost:5439/nawa

# Legacy health compatibility flag. Keep disabled for the private named-profile
# experience; active routes require an explicitly selected named profile.
ENABLE_PUBLIC_DEMO=false
# Historical alias accepted by older local scripts.
ENABLE_DEMO_LEARNER=false

# Optional: only used by legacy seed helpers / docs
DEMO_LEARNER_ID=00000000-0000-4000-8000-000000000001

# Production (set by host)
# NODE_ENV=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

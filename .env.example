# Required: PostgreSQL connection string
DATABASE_URL=postgresql://nawa:nawa_local@localhost:5439/nawa

# Public demo mode: each browser gets an isolated learner via httpOnly cookie.
# ENABLE_DEMO_LEARNER remains accepted for local backward compatibility.
ENABLE_PUBLIC_DEMO=true
ENABLE_DEMO_LEARNER=true

# Optional: only used by legacy seed helpers / docs
DEMO_LEARNER_ID=00000000-0000-4000-8000-000000000001

# Production (set by host)
# NODE_ENV=production
# NEXT_PUBLIC_SITE_URL=https://your-app.example.com

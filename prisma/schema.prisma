generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Ability {
  READING
  LISTENING
  WRITING
  SPEAKING
}

enum MasteryState {
  ENCOUNTERED
  RECOGNIZED
  RETRIEVED
  APPLIED
  RETAINED
}

enum SessionStatus {
  ACTIVE
  COMPLETE
}

enum LessonProgressStatus {
  AVAILABLE
  IN_PROGRESS
  COMPLETE
}

model Profile {
  id        String            @id @db.Uuid
  name      String
  createdAt DateTime          @default(now())
  mastery   MasterySnapshot[]
  evidence  EvidenceEvent[]
  sessions  StudySession[]
  lessons   LessonProgress[]
  devices   Device[]
  mutations SyncMutation[]
  changes   SyncChange[]
  courseEnrollments CourseEnrollment[]
  courseSkills      CourseSkillProgress[]
  courseReviews     CourseReview[]
  courseAttempts    CourseAttempt[]
  rewardLedger      RewardLedger[]
  dailyActivity     DailyActivity[]
}

model KnowledgeAtomRecord {
  id      String @id
  payload Json
}

model MasterySnapshot {
  profileId                 String       @db.Uuid
  atomId                    String
  ability                   Ability
  state                     MasteryState
  successfulRetrievals      Int          @default(0)
  lastAttemptAt             DateTime?
  lastSuccessfulRetrievalAt DateTime?
  nextReviewAt              DateTime
  profile                   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, atomId, ability])
  @@index([profileId, nextReviewAt])
}

model EvidenceEvent {
  id                 String       @id @db.Uuid
  profileId          String       @db.Uuid
  sessionId          String       @db.Uuid
  taskId             String
  atomId             String
  ability            Ability
  occurredAt         DateTime
  correct            Boolean
  responseMode       String
  helpLevel          Int
  latencyMs          Int
  confidence         Int
  novelContext       Boolean
  analysisConfidence Float?
  curriculumVersion  Int?
  skillId            String?
  exerciseType       String?
  responseTimeMs     Int?
  hintUsed           Boolean?
  errorClassification String?
  handwritingMetrics Json?
  profile            Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  session            StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([profileId, atomId, ability, occurredAt])
}

model StudySession {
  id               String          @id @default(uuid()) @db.Uuid
  profileId        String          @db.Uuid
  durationMinutes  Int
  plan             Json
  currentTaskIndex Int             @default(0)
  status           SessionStatus   @default(ACTIVE)
  startedAt        DateTime
  updatedAt        DateTime        @updatedAt
  courseId         String?
  curriculumVersion Int?
  lessonId         String?
  profile          Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  evidence         EvidenceEvent[]

  @@index([profileId, status, updatedAt])
  @@index([profileId, courseId, curriculumVersion, lessonId, status])
}

model LessonProgress {
  profileId    String               @db.Uuid
  lessonId     String
  status       LessonProgressStatus @default(AVAILABLE)
  scoreCorrect Int                  @default(0)
  scoreTotal   Int                  @default(0)
  completedAt  DateTime?
  updatedAt    DateTime             @updatedAt
  profile      Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, lessonId])
  @@index([profileId, status])
}

model Device {
  id         String   @id @db.Uuid
  profileId  String   @db.Uuid
  label      String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, lastSeenAt])
}

model SyncMutation {
  mutationId String   @id @db.Uuid
  profileId  String   @db.Uuid
  deviceId   String   @db.Uuid
  kind       String
  payload    Json
  status     String   @default("ACKNOWLEDGED")
  result     Json?
  createdAt  DateTime @default(now())
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model SyncChange {
  id         BigInt   @id @default(autoincrement())
  profileId  String   @db.Uuid
  entityType String
  entityId   String
  operation  String
  revision   Int
  payload    Json
  createdAt  DateTime @default(now())
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, id])
  @@index([profileId, entityType, entityId, revision])
  @@unique([profileId, entityType, entityId, revision])
}

model CourseEnrollment {
  profileId          String   @db.Uuid
  courseId           String
  curriculumVersion  Int
  enrolledAt         DateTime @default(now())
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, courseId, curriculumVersion])
}

model CourseSkillProgress {
  profileId          String   @db.Uuid
  courseId           String
  curriculumVersion  Int
  skillId            String
  attemptCount       Int      @default(0)
  correctCount       Int      @default(0)
  status             String   @default("AVAILABLE")
  masteredAt         DateTime?
  updatedAt          DateTime @updatedAt
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, courseId, curriculumVersion, skillId])
  @@index([profileId, courseId, curriculumVersion, status])
}

model CourseReview {
  profileId          String   @db.Uuid
  courseId           String
  curriculumVersion  Int
  skillId            String
  dueAt              DateTime
  lastReviewedAt     DateTime?
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, courseId, curriculumVersion, skillId])
  @@index([profileId, dueAt])
}

model CourseAttempt {
  id                  String   @id @db.Uuid
  profileId           String   @db.Uuid
  courseId            String
  curriculumVersion   Int
  lessonId            String
  skillId             String
  exerciseType        String
  correct             Boolean
  responseTimeMs      Int
  hintUsed            Boolean @default(false)
  errorClassification String?
  handwritingMetrics  Json?
  occurredAt          DateTime
  profile             Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, courseId, curriculumVersion, skillId, occurredAt])
  @@index([profileId, courseId, curriculumVersion, lessonId])
}

model RewardLedger {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  originKey String
  reason    String
  xp        Int
  ink       Int      @default(0)
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, originKey])
  @@index([profileId, createdAt])
}

model DailyActivity {
  profileId String   @db.Uuid
  day       DateTime @db.Date
  xp        Int      @default(0)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, day])
}
